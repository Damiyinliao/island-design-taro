{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["@tarojs/taro"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "env.d.ts"],
  "references": []
}
